<!doctype html>
<html>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>Inspection Dashboard</title>
  <style>
    body { font-family: Arial, sans-serif; margin: 20px; }
    .row { display:flex; gap:12px; flex-wrap:wrap; margin-bottom: 12px; }
    .card { border:1px solid #ddd; border-radius:10px; padding:12px; min-width:240px; }
    table { width:100%; border-collapse: collapse; }
    th, td { border-bottom:1px solid #eee; padding:8px; text-align:left; }
    th { background:#fafafa; position: sticky; top:0; }
    .muted { color:#666; font-size: 12px; }
    input { padding:8px; width: 320px; }
  </style>
</head>
<body>
  <h2>Inspection Dashboard</h2>

  <div class="row">
    <div class="card">
      <div><b>Status</b></div>
      <div id="status" class="muted">Loading...</div>
    </div>
    <div class="card">
      <div><b>Last update</b></div>
      <div id="lastRefresh" class="muted">-</div>
    </div>
  </div>

  <div class="row">
    <input id="search" placeholder="Search UID key / name..." />
  </div>

  <h3>Latest Inspections</h3>
  <table>
    <thead>
      <tr>
        <th>UID Key</th>
        <th>Name</th>
        <th>Status</th>
        <th>Inspector</th>
        <th>Inspected At</th>
      </tr>
    </thead>
    <tbody id="latestBody"></tbody>
  </table>

  <script type="module" src="./app.js"></script>
</body>
</html>
